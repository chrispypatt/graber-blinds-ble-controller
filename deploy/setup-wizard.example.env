# Copy to a private host file with mode 0600. Never commit populated values.
GRABER_SETUP_SOURCE_DIR=/opt/graber-controller
GRABER_SETUP_PYTHONPATH=/opt/graber-controller
GRABER_SETUP_TOKEN_FILE=/var/lib/graber-controller/setup-token
# "auto" selects all powered external USB Bluetooth controllers.
GRABER_SETUP_CONTROLLER_ADDRESSES=auto
GRABER_SETUP_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Optional additional group suggestions. Common room and whole-home groups are built in.
# GRABER_SETUP_GROUP_NAMES='Example Room,Upstairs'
GRABER_SETUP_EXPORT_DIR=/etc/graber-controller
# Optional existing mode-0600 secrets used to prefill verified access codes.
# GRABER_SETUP_KNOWN_SECRETS=/path/to/private/known-secrets.toml
GRABER_SETUP_HOST=127.0.0.1
GRABER_SETUP_PORT=18080
GRABER_SETUP_ALLOW_CODE_READ=true
GRABER_SETUP_ALLOW_JOG=true
