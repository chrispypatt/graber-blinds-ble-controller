# Copy to a private host file with mode 0600. Never commit populated values.
GRABER_SETUP_SOURCE_DIR=/path/to/graber-controller-source
GRABER_SETUP_TOKEN_FILE=/path/to/private/setup-token
GRABER_SETUP_CONTROLLER_ADDRESSES=AA:BB:CC:DD:EE:01,AA:BB:CC:DD:EE:02
GRABER_SETUP_ALLOWED_NETWORKS=192.168.1.0/24
GRABER_SETUP_EXPORT_DIR=/path/to/private/setup-export
GRABER_SETUP_HOST=0.0.0.0
GRABER_SETUP_PORT=8090
GRABER_SETUP_ALLOW_CODE_READ=false
GRABER_SETUP_ALLOW_JOG=false
