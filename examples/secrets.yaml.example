wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
# Generate a unique key with: openssl rand -base64 32
# CI replaces this placeholder with a generated key before compiling.
api_key: "REPLACE_WITH_A_UNIQUE_BASE64_KEY"
ap_password: "YOUR_FALLBACK_AP_PASSWORD"

# These are synthetic, compile-only values. Replace them with private values
# in the deployment's ignored secrets.yaml; never use them for a real blind.
graber_living_left_mac: "AA:BB:CC:DD:EE:01"
graber_living_left_token: "1234567"
graber_living_right_mac: "AA:BB:CC:DD:EE:02"
graber_living_right_token: "7654321"
